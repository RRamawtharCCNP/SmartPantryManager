<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Settings" android:textSize="26sp" android:textStyle="bold" />
    <Switch android:id="@+id/expirySwitch" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Show expiring-soon alerts" android:paddingTop="16dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Quantities are normalised before recipe matching. Weight uses grams, volume uses millilitres, and countable items use units." android:paddingTop="20dp" />
</LinearLayout>
